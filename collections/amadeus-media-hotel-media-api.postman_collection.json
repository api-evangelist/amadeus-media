                "reference-data",
                "locations",
                "hotels",
                "by-hotels",
                "media"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "hotelIds",
                  "value": "<string>",
                  "description": "(Required) Amadeus property codes (8 characters). Up to 20 hotel IDs per request."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Filter media by category. Options: EXTERIOR, LOBBY, ROOM, RESTAURANT, POOL, SPA, GYM, MEETING_ROOM, COMMON_AREA."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Preferred image format. Options: JPEG, PNG, WEBP."
                }
              ],
              "variable": []
