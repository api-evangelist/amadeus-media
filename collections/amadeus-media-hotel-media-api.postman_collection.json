          "request": {
            "name": "Amadeus Get Hotel Media",
            "description": {
              "content": "Returns media assets (images, videos) for one or more hotels in the Amadeus inventory. Media includes exterior shots, lobby photos, room images, restaurant photos, and amenity images categorized by type.",
              "type": "text/plain"
            },
            "url": {
