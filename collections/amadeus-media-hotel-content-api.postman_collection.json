          "id": "f646c800-79f9-4f9d-8192-1729e17849ac",
          "name": "Amadeus Get Hotel Content",
          "request": {
            "name": "Amadeus Get Hotel Content",
            "description": {
              "content": "Returns detailed content for one or more hotels including property descriptions, amenities, facilities, contact information, geolocation, and media assets such as images and videos. Provide one or more hotel IDs (Amadeus property codes) to retrieve their content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reference-data",
                "locations",
                "hotels",
                "by-hotels",
                "content"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "hotelIds",
                  "value": "<string>",
                  "description": "(Required) Amadeus property codes (8 characters) for which to retrieve content. Up to 20 hotel IDs can be specified per request."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Language code for the content response (e.g., EN, FR, DE). Defaults to English if not specified."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of content fields to include in the response. Options include: basicInfo, descriptions, amenities, media, contact, location."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.amadeus+json"
              }
            ],
            "method": "GET",
            "auth": null
          },
